# Resend (email)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxx
MAIL_FROM=Nuvera Form <hello@nuveraform.com>
OWNER_EMAIL=info@nuveraform.com
ALLOWED_ORIGINS=https://nuveraform.com,https://www.nuveraform.com

# Inventory store: added automatically when you install "Upstash Redis" from the Vercel Marketplace (Storage tab)
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Owner admin page (/admin): any long random string, 12+ characters
ADMIN_TOKEN=

# Cloudflare Turnstile (spam protection). The SITE key goes in assets/site-config.js; the SECRET goes here.
TURNSTILE_SECRET=
